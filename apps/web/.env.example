# URL absoluta da API, lida somente pelo servidor Next. Sem credenciais/query.
# Em produção, use HTTPS externo ou o endereço da rede privada validada.
API_BASE_URL=http://localhost:3333
# Public bucket URL only (no key); restricts next/image to this host and path.
SUPABASE_STORAGE_PUBLIC_URL=https://YOUR_PROJECT.supabase.co/storage/v1/object/public/portfolio/
