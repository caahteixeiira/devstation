# Conexão PostgreSQL; substitua os placeholders. Use o TLS exigido pelo provedor.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Gere um segredo aleatório com pelo menos 32 caracteres; não use um valor de exemplo.
JWT_SECRET=

# Somente seed manual. Não são necessárias no runtime após criar o administrador.
ADMIN_NAME=
ADMIN_EMAIL=
# Pelo menos 12 caracteres, sem espaços. Nunca publique essa senha.
ADMIN_PASSWORD=

PORT=3333
NODE_ENV=development
# Uma única origem HTTP(S). Obrigatória em produção; sem *, caminho ou credenciais.
CORS_ORIGIN=http://localhost:3000
# Opcional: IPs/CIDRs dos proxies confiáveis, separados por vírgula. Vazio = não confiar.
# Configure somente após conhecer a topologia do provedor; não use true ou 0.0.0.0/0.
TRUST_PROXY=
