{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "src/generated/prisma/**"],
      "env": ["API_BASE_URL", "NODE_ENV"],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["API_BASE_URL", "DATABASE_URL", "JWT_SECRET", "PORT", "CORS_ORIGIN", "TRUST_PROXY", "NODE_ENV"]
    },
    "lint": {},
    "test": {}
  }
}
